{
  "name": "dsh-composer-draft-cache",
  "version": "1.5.4",
  "private": true,
  "type": "module",
  "description": "Composer enhancements for DeepSeek Harness: caches unsent drafts per workspace and per session, and lets users @-mention an installed plugin so the agent uses it for that turn.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "CatLollipop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatLollipop/dsh-composer-draft-cache.git"
  },
  "homepage": "https://github.com/CatLollipop/dsh-composer-draft-cache#readme",
  "bugs": {
    "url": "https://github.com/CatLollipop/dsh-composer-draft-cache/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "draft",
    "composer",
    "workspace",
    "mention",
    "at-mention"
  ]
}
